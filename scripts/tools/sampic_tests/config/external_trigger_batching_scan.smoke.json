{
  "scan": {
    "frames_per_block": [31],
    "triggers_per_event": [127],
    "acquisition_schemes": ["l2_external_gate", "self_trigger", "external"],
    "lecroy_rates_hz": [100],
    "repetitions": 1
  },
  "acquisition": {
    "duration_s": 3,
    "max_events": 100000,
    "pipelined_decode": true,
    "raw_queue_capacity": 128
  },
  "correlation": {
    "hit_offset_ns": -470,
    "auto_hit_offset": true,
    "pre_window_ns": 500,
    "post_window_ns": 500
  },
  "l2_gate": {
    "primitive_gate_clocks": 10,
    "latency_gate_clocks": 3,
    "external_gate_clocks": 5
  },
  "drain": {
    "quiet_ms": 100,
    "timeout_s": 10
  },
  "retry": {
    "max_point_retries": 5,
    "delay_s": 2
  },
  "probe": {
    "hardware_config": "config/double_pulse_deadtime_scan.default.json"
  },
  "output": {
    "root_directory": "data/external_trigger_batching_scan/smoke_test"
  },
  "notes": "Three-point smoke test at 100 Hz: L2 external gate, plain self-trigger, and plain external trigger."
}
